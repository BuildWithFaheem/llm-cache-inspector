{
  "name": "redis-pattern-profiler",
  "version": "0.1.0",
  "description": "Scan a Redis keyspace, infer key patterns, and aggregate MEMORY USAGE per pattern",
  "bin": {
    "redis-pattern-profiler": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "test:e2e": "npm run build && node e2e/run.js"
  },
  "dependencies": {
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
